{
  "name": "@sdkforge/core",
  "version": "0.1.0",
  "description": "OpenAPI to typed TypeScript client SDK generator",
  "main": "dist/index.js",
  "types": "dist/index.d.ts",
  "files": [
    "dist/",
    "bin/"
  ],
  "bin": {
    "sdkforge": "bin/sdkforge.js"
  },
  "scripts": {
    "build": "tsc",
    "lint": "eslint src/",
    "test": "jest --coverage",
    "test:watch": "jest --watch",
    "clean": "rm -rf dist",
    "prepublishOnly": "npm run build"
  },
  "keywords": [
    "openapi",
    "typescript",
    "sdk",
    "code-generator",
    "rest"
  ],
  "author": "",
  "license": "MIT",
  "repository": {
    "type": "git",
    "url": "https://github.com/sdkforge/sdk-forge.git"
  },
  "bugs": {
    "url": "https://github.com/sdkforge/sdk-forge/issues"
  },
  "homepage": "https://github.com/sdkforge/sdk-forge",
  "devDependencies": {
    "@types/jest": "^29.5.12",
    "@types/node": "^20.11.0",
    "eslint": "^8.56.0",
    "jest": "^29.7.0",
    "ts-jest": "^29.1.2",
    "typescript": "^5.3.3"
  },
  "dependencies": {
    "openapi-types": "^12.1.3",
    "yaml": "^3.0.4"
  }
}
